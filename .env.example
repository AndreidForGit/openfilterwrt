# OpenWrt Mobile Controller - example environment file.
#
# Copy this file to ".env" and edit the values:
#
#     cp .env.example .env
#
# The program loads ".env" automatically when it starts. Set ENV_FILE_PATH to use
# a different path. Real environment variables always win over the values in this
# file, and the file is silently ignored when it does not exist.
#
# Syntax: KEY=VALUE, an optional "export " prefix, full line comments with "#",
# values wrapped in single or double quotes, and empty values such as KEY=.

# --- Router SSH connection (required) ---
ROUTER_ADDRESS=192.168.1.1
ROUTER_USERNAME=root
ROUTER_PASSWORD=change-me

# --- Router SSH connection (optional) ---
# ROUTER_PRIVATE_KEY_PATH=
# ROUTER_PRIVATE_KEY=
# ROUTER_PRIVATE_KEY_PASSPHRASE=
# ROUTER_HOST_KEY_FINGERPRINT=
# ROUTER_SSH_TIMEOUT_SECONDS=10
# DNSMASQ_SERVICE_NAME=dnsmasq
# ROUTER_WIRELESS_SECTIONS=

# --- HTTP server (optional) ---
# LISTEN_ADDRESS=:8080
# STATIC_DIRECTORY=/app/static
# API_BEARER_TOKEN=

# --- Where to find this file (optional) ---
# ENV_FILE_PATH=.env
